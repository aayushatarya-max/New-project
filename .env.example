# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and fill in your local system details.
# ==============================================================================

# Database
DATABASE_URL=sqlite:///backend/database/memory.db

# Vector Index
FAISS_INDEX_PATH=vector_store/index.faiss

# File Uploads Directory
UPLOAD_DIR=uploads/

# Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Speech Transcription Configuration (Whisper)
# Options: tiny, base, small, medium, large
WHISPER_MODEL_NAME=base

# Tesseract OCR Executable Path (Windows example)
# Replace with your actual local path to tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Logging Configuration
LOG_LEVEL=INFO

# Application Execution Mode ('local' or 'live')
APP_ENV=local

# Supabase Cloud Storage Configuration (For Live Deployment)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_BUCKET=memory-files
